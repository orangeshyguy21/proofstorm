    "statefulSets": [
      {
        "apiVersion": "apps/v1",
        "kind": "StatefulSet",
        "metadata": {
          "annotations": {
            "proofstorm.dev/backend-id": "bitcoin-core",
            "proofstorm.dev/execution-state-contract": "proofstorm/bitcoin-core-state/v1",
            "proofstorm.dev/revision-digest": "sha256:b2-golden-revision"
          },
          "labels": {
            "app.kubernetes.io/managed-by": "proofstormd",
            "proofstorm.dev/component": "chain",
            "proofstorm.dev/instance": "i-golden-b2",
            "proofstorm.dev/network-identity": "chain"
          },
          "name": "chain",
          "namespace": "proofstorm-i-golden-b2"
        },
        "spec": {
          "replicas": 1,
          "selector": {
            "matchLabels": {
              "app.kubernetes.io/managed-by": "proofstormd",
              "proofstorm.dev/component": "chain",
              "proofstorm.dev/instance": "i-golden-b2",
              "proofstorm.dev/network-identity": "chain"
            }
          },
          "serviceName": "chain",
          "template": {
            "metadata": {
              "annotations": {
                "proofstorm.dev/rollout-digest": "sha256:a92209dbe87d127d269888c2dae43c1dd17c7e60d6d813674cdbaa36c1599f7e"
              },
              "labels": {
                "app.kubernetes.io/managed-by": "proofstormd",
                "proofstorm.dev/component": "chain",
                "proofstorm.dev/instance": "i-golden-b2",
                "proofstorm.dev/network-identity": "chain"
              }
            },
            "spec": {
              "affinity": {
                "podAffinity": {
                  "requiredDuringSchedulingIgnoredDuringExecution": [
                    {
                      "labelSelector": {
                        "matchLabels": {
                          "proofstorm.dev/instance": "i-golden-b2"
                        }
                      },
                      "topologyKey": "kubernetes.io/hostname"
                    }
                  ]
                }
              },
              "automountServiceAccountToken": false,
              "containers": [
                {
                  "args": [
                    "-regtest",
                    "-datadir=/home/bitcoin/.bitcoin",
                    "-server=1",
                    "-rpcbind=0.0.0.0",
                    "-rpcallowip=0.0.0.0/0",
                    "-rpcuser=proofstorm",
                    "-rpcpassword=proofstorm-regtest-only",
                    "-rpcport=18443",
                    "-txindex=1",
                    "-zmqpubrawblock=tcp://0.0.0.0:28334",
                    "-zmqpubrawtx=tcp://0.0.0.0:28335",
                    "-fallbackfee=0.0002",
                    "-debug=0"
                  ],
                  "command": [
                    "bitcoind"
                  ],
                  "image": "docker.io/polarlightning/bitcoind@sha256:6b15e7efb79995a18441806f509e40316428a901f1cdc5c54cd25b03ac513cb9",
                  "imagePullPolicy": "IfNotPresent",
                  "name": "component",
                  "readinessProbe": {
                    "exec": {
                      "command": [
                        "bitcoin-cli",
                        "-regtest",
                        "-rpcuser=proofstorm",
                        "-rpcpassword=proofstorm-regtest-only",
                        "getblockchaininfo"
                      ]
                    },
                    "failureThreshold": 40,
                    "periodSeconds": 3
                  },
                  "securityContext": {
                    "allowPrivilegeEscalation": false,
                    "capabilities": {
                      "drop": [
                        "ALL"
                      ]
                    }
                  },
                  "volumeMounts": [
                    {
                      "mountPath": "/home/bitcoin/.bitcoin",
                      "name": "data"
                    }
                  ]
                }
              ],
              "enableServiceLinks": false,
              "securityContext": {
                "fsGroup": 1000,
                "runAsGroup": 1000,
                "runAsNonRoot": true,
                "runAsUser": 1000,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "serviceAccountName": "proofstorm-workload"
            }
          },
          "volumeClaimTemplates": [
            {
              "apiVersion": "v1",
              "kind": "PersistentVolumeClaim",
              "metadata": {
                "labels": {
                  "app.kubernetes.io/managed-by": "proofstormd",
                  "proofstorm.dev/component": "chain",
                  "proofstorm.dev/instance": "i-golden-b2",
                  "proofstorm.dev/network-identity": "chain"
                },
                "name": "data"
              },
              "spec": {
                "accessModes": [
                  "ReadWriteOnce"
                ],
                "resources": {
                  "requests": {
                    "storage": "1Gi"
                  }
                }
              }
            }
          ]
        }
      }
