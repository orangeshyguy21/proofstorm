                  "volumeMounts": [
                    {
                      "mountPath": "/opt/proofstorm",
                      "name": "proofstorm-driver"
                    }
                  ]
                },
                {
                  "command": [
                    "sh",
                    "-ec",
                    "n=0; while [ \"$n\" -lt 120 ]; do if /opt/proofstorm/driver tcp \"$1\" \"$2\" && /opt/proofstorm/driver tcp \"$3\" \"$4\"; then exit 0; fi; n=$((n+1)); sleep 1; done; echo 'Bark dependencies did not become ready' >&2; exit 1",
                    "--",
                    "chain",
                    "18443",
                    "ark",
                    "3535"
