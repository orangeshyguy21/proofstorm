      "storage_ready": [
        "not_observed",
        "storage_bound",
        "storage_pending"
      ],
      "workload_ready": [
        "not_observed",
        "stale_revision",
        "workload_available",
        "workload_unavailable",
        "image_pull_failed",
        "image_pull_backoff",
        "invalid_image_name",
        "container_config_error",
        "container_crash_loop",
        "container_start_error",
        "container_exited",
        "pod_unschedulable",
        "intentionally_stopped"
      ]
