                  "name": "component",
                  "readinessProbe": {
                    "exec": {
                      "command": [
                        "/bin/sh",
                        "-c",
                        "test -w /wallet/cdk && cdk-cli --version"
                      ]
                    },
                    "timeoutSeconds": 3
                  },
                  "securityContext": {
                    "allowPrivilegeEscalation": false,
                    "capabilities": {
