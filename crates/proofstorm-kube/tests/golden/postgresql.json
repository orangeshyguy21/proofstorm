        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "proofstormd",
            "proofstorm.dev/component": "database",
            "proofstorm.dev/instance": "i-golden-b2",
            "proofstorm.dev/network-identity": "database"
          },
          "name": "database-credentials",
          "namespace": "proofstorm-i-golden-b2"
        },
        "stringData": {
          "POSTGRES_DB": "cdk_mint",
          "POSTGRES_USER": "proofstorm"
        },
        "type": "Opaque"
      }
    ],
    "services": [
      {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "proofstormd",
            "proofstorm.dev/component": "database",
            "proofstorm.dev/instance": "i-golden-b2",
            "proofstorm.dev/network-identity": "database"
          },
          "name": "database",
          "namespace": "proofstorm-i-golden-b2"
        },
        "spec": {
          "ports": [
            {
              "name": "postgres",
              "port": 5432,
              "targetPort": 5432
            }
          ],
          "selector": {
            "app.kubernetes.io/managed-by": "proofstormd",
            "proofstorm.dev/component": "database",
            "proofstorm.dev/instance": "i-golden-b2",
            "proofstorm.dev/network-identity": "database"
          }
        }
      }
    ],
    "statefulSets": [
      {
        "apiVersion": "apps/v1",
        "kind": "StatefulSet",
        "metadata": {
          "annotations": {
            "proofstorm.dev/backend-id": "postgresql",
            "proofstorm.dev/execution-state-contract": "proofstorm/postgresql-state/v1",
            "proofstorm.dev/revision-digest": "sha256:b2-golden-revision"
          },
          "labels": {
            "app.kubernetes.io/managed-by": "proofstormd",
            "proofstorm.dev/component": "database",
            "proofstorm.dev/instance": "i-golden-b2",
            "proofstorm.dev/network-identity": "database"
          },
          "name": "database",
          "namespace": "proofstorm-i-golden-b2"
        },
        "spec": {
          "replicas": 1,
          "selector": {
            "matchLabels": {
              "app.kubernetes.io/managed-by": "proofstormd",
              "proofstorm.dev/component": "database",
              "proofstorm.dev/instance": "i-golden-b2",
              "proofstorm.dev/network-identity": "database"
            }
          },
          "serviceName": "database",
          "template": {
            "metadata": {
              "annotations": {
                "proofstorm.dev/rollout-digest": "sha256:1c9ae523d44e66407f252d1a0394956ce94d7d94e4a39dffe759d85aad61dcdb"
              },
              "labels": {
                "app.kubernetes.io/managed-by": "proofstormd",
                "proofstorm.dev/component": "database",
                "proofstorm.dev/instance": "i-golden-b2",
                "proofstorm.dev/network-identity": "database"
              }
            },
            "spec": {
              "affinity": {
                "podAffinity": {
                  "requiredDuringSchedulingIgnoredDuringExecution": [
                    {
                      "labelSelector": {
                        "matchLabels": {
                          "proofstorm.dev/instance": "i-golden-b2"
                        }
                      },
                      "topologyKey": "kubernetes.io/hostname"
                    }
                  ]
                }
              },
              "automountServiceAccountToken": false,
              "containers": [
                {
                  "env": [
                    {
                      "name": "PGDATA",
                      "value": "/var/lib/postgresql/data/pgdata"
                    },
                    {
                      "name": "POSTGRES_USER",
                      "valueFrom": {
                        "secretKeyRef": {
                          "key": "POSTGRES_USER",
                          "name": "database-credentials"
                        }
                      }
                    },
                    {
                      "name": "POSTGRES_PASSWORD",
                      "valueFrom": {
                        "secretKeyRef": {
                          "key": "POSTGRES_PASSWORD",
                          "name": "database-credentials"
                        }
                      }
                    },
                    {
                      "name": "POSTGRES_DB",
                      "valueFrom": {
                        "secretKeyRef": {
                          "key": "POSTGRES_DB",
                          "name": "database-credentials"
                        }
                      }
                    }
                  ],
                  "image": "docker.io/library/postgres@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73",
                  "imagePullPolicy": "IfNotPresent",
                  "name": "component",
                  "ports": [
                    {
                      "containerPort": 5432,
                      "name": "postgres"
                    }
                  ],
                  "readinessProbe": {
                    "exec": {
                      "command": [
                        "pg_isready",
                        "-U",
                        "proofstorm",
                        "-d",
                        "cdk_mint"
                      ]
                    },
                    "failureThreshold": 40,
                    "periodSeconds": 3
                  },
                  "securityContext": {
                    "allowPrivilegeEscalation": false,
                    "capabilities": {
                      "drop": [
                        "ALL"
                      ]
                    }
                  },
                  "volumeMounts": [
                    {
                      "mountPath": "/var/lib/postgresql/data",
                      "name": "data"
                    }
                  ]
                }
              ],
              "enableServiceLinks": false,
              "securityContext": {
                "fsGroup": 70,
                "runAsGroup": 70,
                "runAsNonRoot": true,
                "runAsUser": 70,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "serviceAccountName": "proofstorm-workload"
            }
          },
          "volumeClaimTemplates": [
            {
              "apiVersion": "v1",
              "kind": "PersistentVolumeClaim",
              "metadata": {
                "labels": {
                  "app.kubernetes.io/managed-by": "proofstormd",
                  "proofstorm.dev/component": "database",
                  "proofstorm.dev/instance": "i-golden-b2",
                  "proofstorm.dev/network-identity": "database"
                },
                "name": "data"
              },
              "spec": {
                "accessModes": [
                  "ReadWriteOnce"
                ],
                "resources": {
                  "requests": {
                    "storage": "1Gi"
                  }
                }
              }
            }
          ]
        }
      }
    ]
