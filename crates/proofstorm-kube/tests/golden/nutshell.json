                      "labelSelector": {
                        "matchLabels": {
                          "proofstorm.dev/instance": "i-golden-b2"
                        }
                      },
                      "topologyKey": "kubernetes.io/hostname"
                    }
                  ]
                }
              },
              "automountServiceAccountToken": false,
              "containers": [
                {
                  "command": [
                    "python3",
                    "-c",
                    "from cashu.mint.main import main; main()"
                  ],
                  "env": [
                    {
                      "name": "MINT_PRIVATE_KEY",
                      "valueFrom": {
                        "secretKeyRef": {
                          "key": "MINT_PRIVATE_KEY",
                          "name": "mint-credentials"
                        }
                      }
                    }
                  ],
                  "envFrom": [
                    {
                      "configMapRef": {
