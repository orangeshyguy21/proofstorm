                  "imagePullPolicy": "IfNotPresent",
                  "name": "component",
                  "ports": [
                    {
                      "containerPort": 3338,
                      "name": "http"
                    }
                  ],
                  "readinessProbe": {
                    "exec": {
                      "command": [
                        "python3",
                        "-c",
                        "import sys, urllib.request; urllib.request.urlopen(sys.argv[1], timeout=1).read()",
                        "http://127.0.0.1:3338/v1/info"
                      ]
                    },
                    "failureThreshold": 40,
                    "periodSeconds": 3,
                    "timeoutSeconds": 2
                  },
                  "securityContext": {
                    "allowPrivilegeEscalation": false,
                    "capabilities": {
                      "drop": [
                        "ALL"
