  "resources": {
    "configMaps": [],
    "deployments": [
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "annotations": {
            "proofstorm.dev/backend-id": "redis",
            "proofstorm.dev/execution-state-contract": "proofstorm/redis-cache-state/v1",
            "proofstorm.dev/revision-digest": "sha256:b2-golden-revision"
          },
          "labels": {
            "app.kubernetes.io/managed-by": "proofstormd",
            "proofstorm.dev/component": "cache",
            "proofstorm.dev/instance": "i-golden-b2",
            "proofstorm.dev/network-identity": "cache"
          },
          "name": "cache",
          "namespace": "proofstorm-i-golden-b2"
        },
        "spec": {
          "replicas": 1,
          "selector": {
            "matchLabels": {
              "app.kubernetes.io/managed-by": "proofstormd",
              "proofstorm.dev/component": "cache",
              "proofstorm.dev/instance": "i-golden-b2",
              "proofstorm.dev/network-identity": "cache"
            }
          },
          "template": {
            "metadata": {
              "annotations": {
                "proofstorm.dev/rollout-digest": "sha256:576ba66e32dc3625c98af22340735e818c66f888396f4c0b05ca1146e2947882"
              },
              "labels": {
                "app.kubernetes.io/managed-by": "proofstormd",
                "proofstorm.dev/component": "cache",
                "proofstorm.dev/instance": "i-golden-b2",
                "proofstorm.dev/network-identity": "cache"
              }
            },
            "spec": {
              "affinity": {
                "podAffinity": {
                  "requiredDuringSchedulingIgnoredDuringExecution": [
                    {
                      "labelSelector": {
                        "matchLabels": {
                          "proofstorm.dev/instance": "i-golden-b2"
                        }
                      },
                      "topologyKey": "kubernetes.io/hostname"
                    }
                  ]
                }
              },
              "automountServiceAccountToken": false,
              "containers": [
                {
                  "args": [
                    "exec redis-server --bind 0.0.0.0 --protected-mode yes --port 6379 --save '' --appendonly no --requirepass \"$REDIS_PASSWORD\" --maxmemory 64mb --maxmemory-policy allkeys-lru"
                  ],
                  "command": [
                    "sh",
                    "-c"
                  ],
                  "env": [
                    {
                      "name": "REDIS_PASSWORD",
                      "valueFrom": {
                        "secretKeyRef": {
                          "key": "REDIS_PASSWORD",
                          "name": "cache-credentials"
                        }
                      }
                    }
                  ],
                  "image": "docker.io/library/redis@sha256:becdda6c7f4b3fb42e42fd7f120bbf5c54c4caaaf16f26da24e4563d2c1f0576",
                  "imagePullPolicy": "IfNotPresent",
                  "name": "component",
                  "ports": [
                    {
                      "containerPort": 6379,
                      "name": "redis"
                    }
                  ],
                  "readinessProbe": {
                    "exec": {
                      "command": [
                        "sh",
                        "-c",
                        "redis-cli --no-auth-warning -a \"$REDIS_PASSWORD\" ping | grep -qx PONG"
                      ]
                    },
                    "failureThreshold": 40,
                    "periodSeconds": 3
                  },
                  "securityContext": {
                    "allowPrivilegeEscalation": false,
                    "capabilities": {
                      "drop": [
                        "ALL"
                      ]
                    }
                  }
                }
              ],
              "enableServiceLinks": false,
              "securityContext": {
                "fsGroup": 1000,
                "runAsGroup": 1000,
                "runAsNonRoot": true,
                "runAsUser": 1000,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "serviceAccountName": "proofstorm-workload"
            }
          }
        }
      }
    ],
    "persistentVolumeClaims": [],
    "secrets": [
      {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "proofstormd",
            "proofstorm.dev/component": "cache",
            "proofstorm.dev/instance": "i-golden-b2",
            "proofstorm.dev/network-identity": "cache"
          },
          "name": "cache-credentials",
          "namespace": "proofstorm-i-golden-b2"
        },
        "stringData": {
          "PROOFSTORM_SECRET_KIND": "redis-cache"
        },
        "type": "Opaque"
      }
    ],
    "services": [
      {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {
          "labels": {
            "app.kubernetes.io/managed-by": "proofstormd",
            "proofstorm.dev/component": "cache",
            "proofstorm.dev/instance": "i-golden-b2",
            "proofstorm.dev/network-identity": "cache"
          },
          "name": "cache",
          "namespace": "proofstorm-i-golden-b2"
        },
        "spec": {
          "ports": [
            {
              "name": "redis",
              "port": 6379,
              "targetPort": 6379
            }
          ],
          "selector": {
            "app.kubernetes.io/managed-by": "proofstormd",
            "proofstorm.dev/component": "cache",
            "proofstorm.dev/instance": "i-golden-b2",
            "proofstorm.dev/network-identity": "cache"
          }
        }
      }
    ],
    "statefulSets": []
  }
}
