#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=versions.env
source "${ROOT_DIR}/tools/versions.env"

TOOLS_DIR="${ROOT_DIR}/.tools"
BIN_DIR="${TOOLS_DIR}/bin"
DOWNLOAD_DIR="${TOOLS_DIR}/downloads"
K3D_BIN=""
HELM_BIN=""
KUBECTL_BIN=""

require_tool() {
  local name="$1"
  local path="$2"
  if [[ -z "${path}" ]]; then
    echo "missing ${name}; expected the version pinned in tools/versions.env" >&2
    exit 1
  fi
}

resolve_bins() {
  K3D_BIN="${BIN_DIR}/k3d"
  HELM_BIN="${BIN_DIR}/helm"
  KUBECTL_BIN="${BIN_DIR}/kubectl"
  [[ -x "${K3D_BIN}" ]] || K3D_BIN="$(command -v k3d || true)"
  [[ -x "${HELM_BIN}" ]] || HELM_BIN="$(command -v helm || true)"
  [[ -x "${KUBECTL_BIN}" ]] || KUBECTL_BIN="$(command -v kubectl || true)"
}

platform() {
  case "$(uname -s)" in
    Darwin) PLATFORM_OS=darwin ;;
    Linux) PLATFORM_OS=linux ;;
    *) echo "unsupported operating system: $(uname -s)" >&2; exit 1 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) PLATFORM_ARCH=amd64 ;;
    arm64|aarch64) PLATFORM_ARCH=arm64 ;;
    *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    sha256sum "$1" | awk '{print $1}'
  fi
}

verify_checksum() {
  local path="$1"
  local expected="$2"
  local actual
  actual="$(sha256_file "${path}")"
  if [[ "${actual}" != "${expected}" ]]; then
    echo "checksum mismatch for ${path}: expected ${expected}, got ${actual}" >&2
    exit 1
  fi
}

download() {
  curl --fail --location --retry 3 --silent --show-error "$1" --output "$2"
}

bootstrap_tools() {
  require_tool curl "$(command -v curl || true)"
  require_tool install "$(command -v install || true)"
  require_tool tar "$(command -v tar || true)"
  if ! command -v shasum >/dev/null 2>&1 && ! command -v sha256sum >/dev/null 2>&1; then
    echo "missing SHA-256 utility; install shasum or sha256sum" >&2
    exit 1
  fi
  platform
  mkdir -p "${BIN_DIR}" "${DOWNLOAD_DIR}"

  if [[ ! -x "${BIN_DIR}/k3d" ]] || ! "${BIN_DIR}/k3d" version 2>/dev/null | grep -F "${K3D_VERSION#v}" >/dev/null; then
    local k3d_download="${DOWNLOAD_DIR}/k3d-${K3D_VERSION}-${PLATFORM_OS}-${PLATFORM_ARCH}"
    local k3d_checksums="${DOWNLOAD_DIR}/k3d-${K3D_VERSION}-checksums.txt"
    download "https://github.com/k3d-io/k3d/releases/download/${K3D_VERSION}/k3d-${PLATFORM_OS}-${PLATFORM_ARCH}" "${k3d_download}"
    download "https://github.com/k3d-io/k3d/releases/download/${K3D_VERSION}/checksums.txt" "${k3d_checksums}"
    local k3d_checksum
    k3d_checksum="$(awk -v name="_dist/k3d-${PLATFORM_OS}-${PLATFORM_ARCH}" '$2 == name {print $1}' "${k3d_checksums}")"
    [[ -n "${k3d_checksum}" ]] || { echo "k3d checksum entry was not published" >&2; exit 1; }
    verify_checksum "${k3d_download}" "${k3d_checksum}"
    install -m 0755 "${k3d_download}" "${BIN_DIR}/k3d"
  fi

  if [[ ! -x "${BIN_DIR}/helm" ]] || ! "${BIN_DIR}/helm" version --short 2>/dev/null | grep -F "${HELM_VERSION}" >/dev/null; then
    local helm_archive="${DOWNLOAD_DIR}/helm-${HELM_VERSION}-${PLATFORM_OS}-${PLATFORM_ARCH}.tar.gz"
    local helm_checksum_file="${helm_archive}.sha256sum"
    download "https://get.helm.sh/helm-${HELM_VERSION}-${PLATFORM_OS}-${PLATFORM_ARCH}.tar.gz" "${helm_archive}"
    download "https://get.helm.sh/helm-${HELM_VERSION}-${PLATFORM_OS}-${PLATFORM_ARCH}.tar.gz.sha256sum" "${helm_checksum_file}"
    verify_checksum "${helm_archive}" "$(awk '{print $1}' "${helm_checksum_file}")"
    local helm_unpack
    helm_unpack="$(mktemp -d)"
    tar -xzf "${helm_archive}" -C "${helm_unpack}"
    install -m 0755 "${helm_unpack}/${PLATFORM_OS}-${PLATFORM_ARCH}/helm" "${BIN_DIR}/helm"
    rm -rf -- "${helm_unpack}"
  fi

  if [[ ! -x "${BIN_DIR}/kubectl" ]] || ! "${BIN_DIR}/kubectl" version --client 2>/dev/null | grep -F "${KUBECTL_VERSION#v}" >/dev/null; then
    local kubectl_download="${DOWNLOAD_DIR}/kubectl-${KUBECTL_VERSION}-${PLATFORM_OS}-${PLATFORM_ARCH}"
    local kubectl_checksum_file="${kubectl_download}.sha256"
    download "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/${PLATFORM_OS}/${PLATFORM_ARCH}/kubectl" "${kubectl_download}"
    download "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/${PLATFORM_OS}/${PLATFORM_ARCH}/kubectl.sha256" "${kubectl_checksum_file}"
    verify_checksum "${kubectl_download}" "$(tr -d '[:space:]' < "${kubectl_checksum_file}")"
    install -m 0755 "${kubectl_download}" "${BIN_DIR}/kubectl"
  fi
  resolve_bins
}

doctor() {
  resolve_bins
  require_tool docker "$(command -v docker || true)"
  require_tool python3 "$(command -v python3 || true)"
  require_tool k3d "${K3D_BIN}"
  require_tool kubectl "${KUBECTL_BIN}"
  require_tool helm "${HELM_BIN}"
  docker info >/dev/null
  "${K3D_BIN}" version | grep -F "${K3D_VERSION#v}" >/dev/null
  "${KUBECTL_BIN}" version --client | grep -F "${KUBECTL_VERSION#v}" >/dev/null
  "${HELM_BIN}" version --short | grep -F "${HELM_VERSION}" >/dev/null
  "${KUBECTL_BIN}" --context k3d-proofstorm get namespace proofstorm-system >/dev/null
  "${KUBECTL_BIN}" --context k3d-proofstorm wait --for=condition=Available deployment/proofstormd -n proofstorm-system --timeout=90s
  [[ -x "${ROOT_DIR}/target/release/proofstorm-mcp" ]] || {
    echo "missing release MCP binary; run tools/proofstorm-cluster setup" >&2
    exit 1
  }
  python3 "${ROOT_DIR}/tools/proofstorm-doctor.py" \
    "${ROOT_DIR}/target/release/proofstorm-mcp" "${ROOT_DIR}/examples/opencode.json"
  echo "proofstorm doctor passed: pinned tools, cluster, controller, and MCP discovery are healthy"
}

setup() {
  bootstrap_tools
  require_tool docker "$(command -v docker || true)"
  require_tool cargo "$(command -v cargo || true)"
  require_tool k3d "${K3D_BIN}"
  require_tool kubectl "${KUBECTL_BIN}"
  require_tool helm "${HELM_BIN}"
  if ! "${K3D_BIN}" cluster get proofstorm >/dev/null 2>&1; then
    "${K3D_BIN}" cluster create --config "${ROOT_DIR}/infra/k3d/proofstorm.yaml"
  fi
  docker build --file "${ROOT_DIR}/Dockerfile.proofstormd" \
    --tag "localhost:5111/proofstormd:${PROOFSTORM_VERSION}" "${ROOT_DIR}"
  docker push "localhost:5111/proofstormd:${PROOFSTORM_VERSION}"
  # Helm installs chart CRDs once, but intentionally does not upgrade them.
  # Reconcile the checked-in API definitions before upgrading the controller so
  # reused developer clusters cannot run a new controller against a stale API.
  "${KUBECTL_BIN}" --context k3d-proofstorm apply --server-side --force-conflicts \
    --field-manager=proofstorm-cluster -f "${ROOT_DIR}/charts/proofstorm/crds"
  local existing_labs
  existing_labs="$("${KUBECTL_BIN}" --context k3d-proofstorm get \
    proofstormlabs.proofstorm.dev --all-namespaces -o json)"
  if ! python3 -c '
import json, re, sys
labs = json.load(sys.stdin).get("items", [])
valid_locks = all(
    "rollout_digest" in entry
    and "effective_config_digest" in entry
    and "config_schema_digest" in entry
    and "features" in entry
    and "compatible_dependencies" in entry
    for lab in labs
    for entry in lab.get("spec", {}).get("lock", {}).get("entries", [])
)
valid_bindings = all(
    "id" in link
    and link.get("kind") != "lightning_backend"
    and (
        link.get("kind") not in {"chain_backend", "payment_backend", "database_backend"}
        or (
            isinstance(link.get("binding"), dict)
            and (
                (
                    link["kind"] == "chain_backend"
                    and set(link["binding"]) == {"type", "network"}
                    and link["binding"].get("type") == "chain"
                    and link["binding"].get("network") == "regtest"
                )
                or (
                    link["kind"] == "payment_backend"
                    and set(link["binding"]) == {"type", "method", "unit"}
                    and link["binding"].get("type") == "payment"
                    and link["binding"].get("method") in {"bolt11", "bolt12", "onchain"}
                    and isinstance(link["binding"].get("unit"), str)
                    and re.fullmatch(r"[a-z0-9-]{1,16}", link["binding"]["unit"])
                )
                or (
                    link["kind"] == "database_backend"
                    and set(link["binding"]) == {"type", "role"}
                    and link["binding"].get("type") == "database"
                    and link["binding"].get("role") == "primary"
                )
            )
        )
    )
    for lab in labs
    for link in lab.get("spec", {}).get("lab", {}).get("links", [])
)
valid = valid_locks and valid_bindings
raise SystemExit(0 if valid else 1)
' <<<"${existing_labs}"; then
    echo "existing Proofstorm labs use an incompatible alpha schema" >&2
    echo "labs are not migrated or deleted automatically; reset the disposable developer cluster:" >&2
    echo "  tools/proofstorm-cluster down" >&2
    echo "  tools/proofstorm-cluster setup" >&2
    exit 1
  fi
  "${HELM_BIN}" upgrade --install proofstorm "${ROOT_DIR}/charts/proofstorm" \
    --kube-context k3d-proofstorm \
    --namespace proofstorm-system --create-namespace --rollback-on-failure --wait
  "${KUBECTL_BIN}" --context k3d-proofstorm rollout restart deployment/proofstormd -n proofstorm-system
  "${KUBECTL_BIN}" --context k3d-proofstorm rollout status deployment/proofstormd -n proofstorm-system --timeout=90s
  cargo build --locked --release --manifest-path "${ROOT_DIR}/Cargo.toml" -p proofstorm-mcp
  doctor
}

down() {
  resolve_bins
  require_tool k3d "${K3D_BIN}"
  if "${K3D_BIN}" cluster get proofstorm >/dev/null 2>&1; then
    "${K3D_BIN}" cluster delete proofstorm
  fi
  if "${K3D_BIN}" registry list 2>/dev/null | grep -F 'proofstorm-registry.localhost' >/dev/null; then
    "${K3D_BIN}" registry delete proofstorm-registry.localhost
  fi
}

case "${1:-}" in
  setup) setup ;;
  doctor) doctor ;;
  down) down ;;
  *) echo "usage: $0 {setup|doctor|down}" >&2; exit 2 ;;
esac
