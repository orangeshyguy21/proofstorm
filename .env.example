# Copy to .env and adjust. Defaults match V1 (cdk + FakeWallet, 3 wallets).

# Population size (wallet-1 .. wallet-N must exist in compose.yml)
N_WALLETS=3

# Amount (sats) minted into each wallet by `make fund` / `make smoke`
FUND_AMOUNT=100

# Self-swap amount during `make smoke` (exercises swap path)
SWAP_AMOUNT=1

# Implementation selectors
MINT_IMPL=cdk
WALLET_IMPL=cdk

# Published image tags (aligned with Orchard e2e)
CDK_MINTD_VERSION=0.17.1
CDK_CLI_VERSION=0.17.1
NUTSHELL_VERSION=0.20.2

# Mint HTTP port on the host
MINT_HOST_PORT=3338

# Currency unit for wallet CLI ops
UNIT=sat

# Conservation check (V3). Default expected = N_WALLETS * FUND_AMOUNT.
# CONSERVATION_EXPECTED=300
# CONSERVATION_TOLERANCE=0
# Max sat loss allowed after self-swap vs post-fund snapshot (default: 0 cdk, N_WALLETS nutshell)
# CONSERVATION_SWAP_TOLERANCE=3
