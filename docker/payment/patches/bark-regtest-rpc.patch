 impl BackendConfig {
+    /// Validate before opening wallet storage or contacting any service.
+    pub fn validate_chain_source(&self) -> Result<()> {
+        if self.server_address.trim().is_empty() {
+            bail!("BARK_SERVER_ADDRESS must be explicitly configured");
+        }
+        let esplora = !self.esplora_address.trim().is_empty();
+        let rpc = self.bitcoind_address.is_some();
+        if esplora == rpc {
+            bail!("configure exactly one of BARK_ESPLORA_ADDRESS and BARK_BITCOIND_ADDRESS");
+        }
+        if rpc {
+            if self.network != "regtest" {
+                bail!("the Bitcoin RPC profile requires regtest");
+            }
+            if self
+                .bitcoind_address
+                .as_ref()
+                .is_none_or(|value| value.trim().is_empty())
+            {
+                bail!("BARK_BITCOIND_ADDRESS must not be empty");
+            }
+            if self
+                .bitcoind_cookiefile
+                .as_ref()
+                .is_none_or(|path| !path.is_absolute())
+            {
+                bail!("BARK_BITCOIND_COOKIEFILE must be an absolute private credential file path");
+            }
+        } else if self.bitcoind_cookiefile.is_some() {
+            bail!("RPC credentials require BARK_BITCOIND_ADDRESS");
+        }
+        Ok(())
+    }
+
+    /// Build the wallet configuration without implicit public chain endpoints.
+    pub fn wallet_config(&self, network: bitcoin::Network) -> Result<bark::Config> {
+        self.validate_chain_source()?;
+        if self.bitcoind_address.is_some() && network != bitcoin::Network::Regtest {
+            bail!("the Bitcoin RPC wallet must use regtest");
+        }
+        Ok(bark::Config {
+            server_address: self.server_address.clone(),
+            esplora_address: (!self.esplora_address.trim().is_empty())
+                .then(|| self.esplora_address.clone()),
+            bitcoind_address: self.bitcoind_address.clone(),
+            bitcoind_cookiefile: self.bitcoind_cookiefile.clone(),
+            bitcoind_user: None,
+            bitcoind_pass: None,
+            bitcoind_zmq_address: None,
+            ..bark::Config::network_default(network)
+        })
+    }
