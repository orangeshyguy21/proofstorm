# CDK v0.18.0: d3dec24c784e8fec1fd65f853241c7a2261c7abd.
# Upstream release binaries, verified against GitHub's published asset digests.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS fetch
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
ARG TARGETARCH
RUN set -eu; \
    case "$TARGETARCH" in \
        arm64) arch=aarch64; expected=9e0112477188155d5aeb6970a53b8fd0f336ba563db81ffe74e1fe2beaf48a8f ;; \
        amd64) arch=x86_64; expected=4b68e34a912a282159468bf8391a2d247f02fa1797c1424fc905842cec720153 ;; \
        *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --proto '=https' --retry 3 --max-time 120 \
        "https://github.com/cashubtc/cdk/releases/download/v0.18.0/cdk-cli-0.18.0-$arch" -o /cdk-cli; \
    printf '%s  /cdk-cli\n' "$expected" | sha256sum -c -; \
    chmod 755 /cdk-cli

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=fetch /cdk-cli /usr/local/bin/cdk-cli
LABEL org.opencontainers.image.source="https://github.com/cashubtc/cdk" \
      org.opencontainers.image.revision="d3dec24c784e8fec1fd65f853241c7a2261c7abd" \
      org.opencontainers.image.version="0.18.0"
ENV HOME=/wallet
USER 1000:1000
RUN cdk-cli --version
ENTRYPOINT ["/bin/sh", "-c", "umask 077; trap 'exit 0' TERM INT; while :; do sleep 3600 & wait $!; done"]
