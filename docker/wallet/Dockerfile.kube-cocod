# Build context contains source.tar.gz from the exact codeload URL in provenance.
FROM oven/bun:1.3.10@sha256:b86c67b531d87b4db11470d9b2bd0c519b1976eee6fcd71634e73abfa6230d2e AS build
WORKDIR /opt/coco
COPY source.tar.gz /tmp/source.tar.gz
RUN echo '229d409cf4bf282dc85f23fc4bc1c860f05d40b541a826ef7486ed277d6b5fc9  /tmp/source.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /opt/coco \
    && echo '8c6bc502e3fa1178e3efbb56f86ef8a92d1e9612952a3f8d7268e2de7e611055  bun.lock' | sha256sum -c - \
    && bun install --frozen-lockfile --ignore-scripts
RUN bun run --filter=@cashu/coco-core build \
    && bun run --filter=@cashu/coco-sql-storage build \
    && bun run --filter=@cashu/coco-sqlite-bun build

FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
COPY --from=build /usr/local/bin/bun /usr/local/bin/bun
COPY --from=build /opt/coco /opt/coco
RUN printf '#!/bin/sh\nexec bun /opt/coco/packages/cocod/src/index.ts "$@"\n' > /usr/local/bin/cocod \
    && chmod 755 /usr/local/bin/cocod \
    && cocod --version
ENV HOME=/wallet
WORKDIR /wallet
USER 1000:1000
CMD ["cocod", "daemon"]
