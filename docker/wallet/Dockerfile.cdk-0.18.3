# CDK v0.18.3: b2035a3525c98b22226926bdc20fa128a1351ae5.
# Upstream release binaries, verified against GitHub's published asset digests.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS fetch
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
ARG TARGETARCH
RUN set -eu; \
    case "$TARGETARCH" in \
        arm64) arch=aarch64; expected=e0abad57ba8e152efa311ad2d476def2ab0973cb9bcc6066b024e55496e08235 ;; \
        amd64) arch=x86_64; expected=bb7a8b0f1b9c6a164c7e50f931b25c3e6232cdaedbb18df22368ebb0c024b337 ;; \
        *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --proto '=https' --retry 3 --max-time 120 \
        "https://github.com/cashubtc/cdk/releases/download/v0.18.3/cdk-cli-0.18.3-$arch" -o /cdk-cli; \
    printf '%s  /cdk-cli\n' "$expected" | sha256sum -c -; \
    chmod 755 /cdk-cli

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=fetch /cdk-cli /usr/local/bin/cdk-cli
LABEL org.opencontainers.image.source="https://github.com/cashubtc/cdk" \
      org.opencontainers.image.revision="b2035a3525c98b22226926bdc20fa128a1351ae5" \
      org.opencontainers.image.version="0.18.3"
ENV HOME=/wallet
USER 1000:1000
RUN cdk-cli --version
ENTRYPOINT ["/bin/sh", "-c", "umask 077; trap 'exit 0' TERM INT; while :; do sleep 3600 & wait $!; done"]
