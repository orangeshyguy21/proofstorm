FROM docker.io/cashubtc/nutshell@sha256:f039b0e61f64d67c7212f5472eb5d021c3703cd9e72170aa924906ce6bd1f2ed
# Upstream builds with --no-root, omitting its documented console entrypoints.
# Install only that exact local project; dependencies remain the pinned image's.
RUN poetry install --only-root --no-interaction \
    && cashu --help && mint-cli --help
