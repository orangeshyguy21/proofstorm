{
  "api_version": "proofstorm/v1alpha1",
  "name": "demo",
  "components": [
    {
      "id": "chain",
      "kind": "bitcoin",
      "implementation": "bitcoin-core",
      "version": "31.1",
      "config_version": "bitcoin-core/31/v1",
      "control": "cell",
      "config": {}
    },
    {
      "id": "mint",
      "kind": "mint",
      "implementation": "cdk",
      "version": "0.18.1",
      "config_version": "cdk-mintd/0.18/v1",
      "control": "target",
      "config": {
        "embedded_onchain": "bdk"
      }
    }
  ],
  "links": [
    {
      "id": "mint-chain",
      "kind": "chain_backend",
      "from": "mint",
      "to": "chain",
      "binding": {
        "type": "chain",
        "network": "regtest"
      }
    }
  ],
  "policy": {
    "allow": [],
    "limits": {
      "max_components": 64,
      "max_links": 256,
      "max_config_bytes": 65536
    }
  }
}
