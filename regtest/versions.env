# Pinned container image tags for the proofstorm regtest stack.
# Aligned with Orchard e2e (orchard/e2e/docker/versions.env) so the two
# harnesses exercise the same node versions. Regtest only.

# Polar's prebuilt regtest images (bitcoind + lnd) — same source Orchard uses.
BITCOIND_VERSION=30.0
LND_VERSION=0.20.0-beta

# Cashu mints under test.
CDK_MINTD_VERSION=0.17.6
NUTSHELL_VERSION=0.20.3

# cdk-cli built into the wallet/adversary image (crates.io).
CDK_CLI_VERSION=0.17.6
