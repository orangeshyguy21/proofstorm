FROM rust:1.88.0-alpine AS native
ARG CARGO_BUILD_JOBS=2
ARG TARGETARCH
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY docker/wallet/*-provenance.json ./docker/wallet/
COPY docker/mint/*-provenance.json ./docker/mint/
COPY docker/bitcoin/*-provenance.json ./docker/bitcoin/
RUN --mount=type=cache,id=proofstorm-native-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=proofstorm-native-target-${TARGETARCH},target=/src/target,sharing=locked \
    cargo build --locked --release -p proofstorm-exec && \
    cp target/release/proofstorm-exec /proofstorm-exec

FROM rust:1.88.0-bookworm AS build
ARG CARGO_BUILD_JOBS=2
ARG TARGETARCH
ARG PROOFSTORM_CONTROLLER_SOURCE_SHA256=development
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY docker/wallet/*-provenance.json ./docker/wallet/
COPY docker/mint/*-provenance.json ./docker/mint/
COPY docker/bitcoin/*-provenance.json ./docker/bitcoin/
RUN --mount=type=cache,id=proofstorm-controller-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=proofstorm-controller-target-${TARGETARCH},target=/src/target,sharing=locked \
    PROOFSTORM_CONTROLLER_SOURCE_SHA256=$PROOFSTORM_CONTROLLER_SOURCE_SHA256 cargo build --locked --release -p proofstormd && \
    cp target/release/proofstormd /proofstormd

FROM gcr.io/distroless/cc-debian12:nonroot
ARG PROOFSTORM_CONTROLLER_SOURCE_SHA256=development
LABEL org.opencontainers.image.source="https://github.com/orangeshyguy21/proofstorm" \
      dev.proofstorm.source-sha256=$PROOFSTORM_CONTROLLER_SOURCE_SHA256
COPY --from=build /proofstormd /usr/local/bin/proofstormd
COPY --from=native /proofstorm-exec /usr/local/lib/proofstorm-exec
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/proofstormd"]
