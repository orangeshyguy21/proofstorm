{
  "$defs": {
    "CandidateBuildPhase": {
      "enum": [
        "pending",
        "resolving",
        "building",
        "pushing",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "CandidateBuildProfile": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": "string"
        },
        "catalog_implementations": {
          "description": "Runtime presets served by this artifact. Empty in historical profiles,\nwhich remain restricted to the implementation requested at admission.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "cpu_limit_millicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "deadline_seconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dockerfile": {
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/CatalogFeature"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "type": "string"
        },
        "memory_limit_mib": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "platforms": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "prepare": {
          "description": "Trusted, versioned preparation recipe copied into the immutable build record.",
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "repository",
        "baseline",
        "dockerfile",
        "platforms",
        "features",
        "notes",
        "prepare",
        "cpu_limit_millicores",
        "memory_limit_mib",
        "deadline_seconds"
      ],
      "type": "object"
    },
    "CandidateDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "captured_at_unix": {
          "format": "int64",
          "type": "integer"
        },
        "logs": {
          "additionalProperties": {
            "$ref": "#/$defs/CandidateLog"
          },
          "type": "object"
        }
      },
      "required": [
        "captured_at_unix",
        "logs"
      ],
      "type": "object"
    },
    "CandidateLog": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "unavailable": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "text",
        "truncated"
      ],
      "type": "object"
    },
    "CandidateProvenance": {
      "additionalProperties": false,
      "properties": {
        "baseline_digest": {
          "type": "string"
        },
        "builder_image": {
          "type": "string"
        },
        "input_digest": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/CandidateBuildProfile"
        },
        "profile_digest": {
          "type": "string"
        },
        "requested_source": {
          "additionalProperties": false,
          "properties": {
            "sha": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "type": {
              "enum": [
                "pull_request",
                "commit",
                "tag"
              ],
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_image": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "input_digest",
        "requested_source",
        "platform",
        "source_image",
        "builder_image",
        "baseline_digest",
        "profile",
        "profile_digest"
      ],
      "type": "object"
    },
    "CatalogFeature": {
      "enum": [
        "native_cli",
        "native_cli_entrypoints",
        "mint_management_rpc",
        "regtest",
        "persistent_state",
        "bolt11",
        "bolt12",
        "onchain",
        "clear_auth",
        "blind_auth",
        "sqlite",
        "postgres",
        "redis_cache",
        "oidc_provider",
        "wallet_operations"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_at_unix": {
      "format": "int64",
      "type": "integer"
    },
    "api_version": {
      "type": "string"
    },
    "base_version": {
      "type": "string"
    },
    "build_features": {
      "description": "Packaging guarantees recorded at admission; old builds inherit none.",
      "items": {
        "$ref": "#/$defs/CatalogFeature"
      },
      "type": "array",
      "uniqueItems": true
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at_unix": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "diagnostics": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateDiagnostics"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "image": {
      "type": [
        "string",
        "null"
      ]
    },
    "implementation": {
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/CandidateBuildPhase"
    },
    "principal_id": {
      "type": "string"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateProvenance"
        },
        {
          "type": "null"
        }
      ]
    },
    "pull_request_url": {
      "type": "string"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_digest": {
      "type": "string"
    },
    "resource_name": {
      "type": "string"
    },
    "started_at_unix": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "id",
    "workspace_id",
    "principal_id",
    "implementation",
    "base_version",
    "pull_request_url",
    "resource_name",
    "request_digest",
    "phase",
    "accepted_at_unix"
  ],
  "title": "CandidateBuild",
  "type": "object"
}
