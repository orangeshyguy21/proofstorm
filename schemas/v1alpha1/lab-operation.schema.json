{
  "$defs": {
    "Capability": {
      "enum": [
        "catalog.read",
        "lab.read",
        "lab.create",
        "lab.edit",
        "lab.clone",
        "lab.validate",
        "lab.publish",
        "lab.materialize",
        "lab.status",
        "lab.close",
        "experiment.create",
        "experiment.read",
        "experiment.close",
        "lease.acquire",
        "lease.release",
        "action.cancel",
        "topology.inspect",
        "topology.mutate",
        "node.add",
        "node.remove",
        "node.control",
        "peer.connect",
        "peer.disconnect",
        "wallet.create",
        "wallet.control",
        "wallet.fund",
        "channel.open",
        "channel.close",
        "channel.force_close",
        "channel.rebalance",
        "chain.mine",
        "chain.fee",
        "chain.reorg",
        "network.delay",
        "network.drop",
        "network.partition",
        "network.heal",
        "component.logs",
        "component.exec",
        "authentication.test",
        "traffic.capture",
        "oracle.list",
        "oracle.run",
        "artifact.read",
        "policy.read",
        "policy.edit",
        "snapshot.create",
        "snapshot.restore"
      ],
      "type": "string"
    },
    "OperationArtifact": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "content": true,
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "digest",
        "byte_length",
        "content"
      ],
      "type": "object"
    },
    "OperationKind": {
      "enum": [
        "node_start",
        "node_stop",
        "node_restart",
        "bootstrap_liquidity",
        "peer_connect",
        "peer_disconnect",
        "channel_open",
        "channel_close",
        "channel_force_close",
        "channel_rebalance",
        "network_partition",
        "network_delay",
        "network_loss",
        "network_heal",
        "wallet_initialize",
        "wallet_balance",
        "wallet_fund",
        "wallet_invoice",
        "wallet_pay",
        "wallet_round_trip",
        "conservation_oracle",
        "reachability_oracle",
        "native_exec",
        "component_logs",
        "authentication_conformance",
        "authentication_protected_spend",
        "authentication_replay"
      ],
      "type": "string"
    },
    "OperationPhase": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_at_unix": {
      "format": "int64",
      "type": "integer"
    },
    "artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationArtifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "capability": {
      "$ref": "#/$defs/Capability"
    },
    "completed_at_unix": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "experiment_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "instance_id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/OperationKind"
    },
    "lease_id": {
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/OperationPhase"
    },
    "principal_id": {
      "type": "string"
    },
    "request": true,
    "request_digest": {
      "type": "string"
    },
    "resource_name": {
      "type": "string"
    },
    "sequence": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "started_at_unix": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "instance_id",
    "experiment_id",
    "lease_id",
    "principal_id",
    "sequence",
    "kind",
    "capability",
    "resource_name",
    "request_digest",
    "request",
    "phase",
    "accepted_at_unix"
  ],
  "title": "LabOperation",
  "type": "object"
}
