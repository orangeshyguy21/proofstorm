{
  "$defs": {
    "BuildProvenance": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "type": "string"
        },
        "artifact_url": {
          "type": "string"
        },
        "build_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit_sha": {
          "type": "string"
        },
        "dependency_lock_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": "string"
        },
        "recipe_digest": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "runtime_image": {
          "type": "string"
        },
        "transformations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "artifact_url",
        "artifact_sha256",
        "platform",
        "runtime_image",
        "recipe_digest"
      ],
      "type": "object"
    },
    "CandidateSource": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "pull_request_url": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "pull_request_url",
        "repository",
        "commit_sha"
      ],
      "type": "object"
    },
    "Capability": {
      "enum": [
        "catalog.read",
        "candidate.build",
        "candidate.read",
        "candidate.cancel",
        "cell.read",
        "cell.create",
        "cell.edit",
        "cell.clone",
        "cell.validate",
        "cell.publish",
        "cell.materialize",
        "cell.status",
        "cell.close",
        "cell.connect",
        "experiment.create",
        "experiment.read",
        "experiment.close",
        "cell.operate",
        "action.cancel",
        "topology.inspect",
        "topology.mutate",
        "node.add",
        "node.remove",
        "node.control",
        "component.control",
        "peer.connect",
        "peer.disconnect",
        "wallet.create",
        "wallet.control",
        "wallet.fund",
        "channel.open",
        "channel.close",
        "channel.force_close",
        "channel.rebalance",
        "chain.mine",
        "chain.fee",
        "chain.reorg",
        "network.delay",
        "network.drop",
        "network.partition",
        "network.heal",
        "component.logs",
        "component.exec_live",
        "component.forensics",
        "authentication.test",
        "traffic.capture",
        "oracle.list",
        "oracle.run",
        "artifact.read",
        "policy.read",
        "policy.edit",
        "snapshot.create",
        "snapshot.restore"
      ],
      "type": "string"
    },
    "CatalogDependencySupport": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "type": "string"
        },
        "link_kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "versions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "link_kind",
        "implementation",
        "versions"
      ],
      "type": "object"
    },
    "CatalogFeature": {
      "enum": [
        "native_cli",
        "mint_management_rpc",
        "regtest",
        "persistent_state",
        "bolt11",
        "bolt12",
        "onchain",
        "clear_auth",
        "blind_auth",
        "sqlite",
        "postgres",
        "redis_cache",
        "oidc_provider",
        "wallet_operations"
      ],
      "type": "string"
    },
    "CellLimits": {
      "additionalProperties": false,
      "properties": {
        "max_components": {
          "description": "Optional user-selected component cap. Omit for no policy cap.",
          "format": "uint64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_config_bytes": {
          "description": "Optional per-component serialized configuration byte cap. Omit for no policy cap.",
          "format": "uint64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_links": {
          "description": "Optional user-selected link cap. Omit for no policy cap.",
          "format": "uint64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CellPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array",
          "uniqueItems": true
        },
        "limits": {
          "$ref": "#/$defs/CellLimits",
          "default": {}
        }
      },
      "type": "object"
    },
    "CellSpec": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentSpec"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/LinkSpec"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/CellPolicy",
          "default": {
            "allow": [],
            "limits": {}
          }
        }
      },
      "required": [
        "api_version",
        "name",
        "components",
        "links"
      ],
      "type": "object"
    },
    "ComponentKind": {
      "enum": [
        "bitcoin",
        "lightning",
        "mint",
        "database",
        "identity_provider",
        "wallet",
        "attacker",
        "proxy",
        "oracle"
      ],
      "type": "string"
    },
    "ComponentSpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "type": "object"
        },
        "config_version": {
          "description": "Version of the implementation adapter's configuration contract.",
          "type": "string"
        },
        "control": {
          "$ref": "#/$defs/ControlClass"
        },
        "id": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "version": {
          "description": "Version of the service binary, image, or implementation.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "implementation",
        "config_version",
        "control",
        "config"
      ],
      "type": "object"
    },
    "ControlClass": {
      "enum": [
        "cell",
        "target",
        "attacker",
        "oracle"
      ],
      "type": "string"
    },
    "DependencyBinding": {
      "additionalProperties": false,
      "description": "Typed dependency qualifier. Chain bindings require network; payment bindings require method and unit; database bindings require a role; authentication bindings require a protocol. Proofstorm validates the discriminator-specific fields before publication.",
      "properties": {
        "method": {
          "enum": [
            "bolt11",
            "bolt12",
            "onchain"
          ],
          "type": "string"
        },
        "network": {
          "enum": [
            "regtest"
          ],
          "type": "string"
        },
        "protocol": {
          "enum": [
            "oidc"
          ],
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "cache",
            "authentication"
          ],
          "type": "string"
        },
        "type": {
          "enum": [
            "chain",
            "payment",
            "database",
            "authentication"
          ],
          "type": "string"
        },
        "unit": {
          "maxLength": 16,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object",
      "x-kubernetes-validations": [
        {
          "message": "chain bindings require only network; payment bindings require only method and unit; database bindings require only role; authentication bindings require only protocol",
          "rule": "self.type == 'chain' ? has(self.network) && !has(self.method) && !has(self.unit) && !has(self.role) && !has(self.protocol) : (self.type == 'payment' ? has(self.method) && has(self.unit) && !has(self.network) && !has(self.role) && !has(self.protocol) : (self.type == 'database' ? has(self.role) && !has(self.network) && !has(self.method) && !has(self.unit) && !has(self.protocol) : has(self.protocol) && !has(self.network) && !has(self.method) && !has(self.unit) && !has(self.role)))"
        }
      ]
    },
    "LinkKind": {
      "enum": [
        "bitcoin_peer",
        "lightning_peer",
        "chain_backend",
        "payment_backend",
        "database_backend",
        "authentication_backend",
        "network_path"
      ],
      "type": "string"
    },
    "LinkSpec": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/DependencyBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "type": "string"
        },
        "id": {
          "description": "Stable binding identity within one cell revision.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "from",
        "to"
      ],
      "type": "object",
      "x-kubernetes-validations": [
        {
          "message": "backend links require a binding; peer and network-path links forbid one",
          "rule": "(self.kind == 'chain_backend' || self.kind == 'payment_backend' || self.kind == 'database_backend' || self.kind == 'authentication_backend') ? has(self.binding) : !has(self.binding)"
        }
      ]
    },
    "LockEntry": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "type": "string"
        },
        "build_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalog_id": {
          "type": "string"
        },
        "compatible_dependencies": {
          "items": {
            "$ref": "#/$defs/CatalogDependencySupport"
          },
          "type": "array"
        },
        "component_id": {
          "type": "string"
        },
        "config_schema_digest": {
          "type": "string"
        },
        "config_version": {
          "type": "string"
        },
        "effective_config_digest": {
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/CatalogFeature"
          },
          "type": "array",
          "uniqueItems": true
        },
        "image": {
          "type": "string"
        },
        "protocol_action_adapter_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollout_digest": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_digest": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "catalog_id",
        "adapter_version",
        "version",
        "config_version",
        "config_schema_digest",
        "features",
        "compatible_dependencies",
        "effective_config_digest",
        "rollout_digest",
        "image",
        "source_digest"
      ],
      "type": "object"
    },
    "ResolvedLock": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/LockEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "api_version",
        "digest",
        "entries"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cell": {
      "$ref": "#/$defs/CellSpec"
    },
    "digest": {
      "type": "string"
    },
    "lock": {
      "$ref": "#/$defs/ResolvedLock"
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "digest",
    "cell",
    "lock"
  ],
  "title": "PublishedRevision",
  "type": "object"
}
