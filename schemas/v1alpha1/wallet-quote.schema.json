{
  "$defs": {
    "WalletQuoteDirection": {
      "description": "The economic direction of a wallet quote from the wallet's perspective.",
      "enum": [
        "receive",
        "pay"
      ],
      "type": "string"
    },
    "WalletQuoteObservationRole": {
      "description": "The role of one wallet-native quote observation in the operation that\nproduced it. Roles make retry deduplication explicit without inventing a\nsecond quote lifecycle.",
      "enum": [
        "invoice_receive",
        "payment_melt",
        "payment_receive",
        "claim_receive"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An immutable, attributed observation of one adapter-native wallet quote.\nThis is a historical observation, not live wallet state.",
  "properties": {
    "amount_sat": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "direction": {
      "$ref": "#/$defs/WalletQuoteDirection"
    },
    "experiment_id": {
      "type": "string"
    },
    "fee_paid_sat": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "fee_reserve_sat": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "instance_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "mint_id": {
      "type": "string"
    },
    "observation_sequence": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "observed_at_unix": {
      "format": "int64",
      "type": "integer"
    },
    "observed_by_operation": {
      "type": "string"
    },
    "principal_id": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/WalletQuoteObservationRole"
    },
    "state": {
      "type": "string"
    },
    "wallet_created_at_unix": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "wallet_expires_at_unix": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "wallet_id": {
      "type": "string"
    },
    "wallet_paid_at_unix": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "observation_sequence",
    "workspace_id",
    "instance_id",
    "experiment_id",
    "lease_id",
    "principal_id",
    "observed_by_operation",
    "role",
    "wallet_id",
    "mint_id",
    "direction",
    "quote_id",
    "amount_sat",
    "state",
    "observed_at_unix"
  ],
  "title": "WalletQuoteObservation",
  "type": "object"
}
