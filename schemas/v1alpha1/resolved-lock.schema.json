{
  "$defs": {
    "BuildProvenance": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "type": "string"
        },
        "artifact_url": {
          "type": "string"
        },
        "build_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit_sha": {
          "type": "string"
        },
        "dependency_lock_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": "string"
        },
        "recipe_digest": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "runtime_image": {
          "type": "string"
        },
        "transformations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "artifact_url",
        "artifact_sha256",
        "platform",
        "runtime_image",
        "recipe_digest"
      ],
      "type": "object"
    },
    "CandidateSource": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "pull_request_url": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "pull_request_url",
        "repository",
        "commit_sha"
      ],
      "type": "object"
    },
    "CatalogDependencySupport": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "type": "string"
        },
        "link_kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "versions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "link_kind",
        "implementation",
        "versions"
      ],
      "type": "object"
    },
    "CatalogFeature": {
      "enum": [
        "native_cli",
        "regtest",
        "persistent_state",
        "bolt11",
        "bolt12",
        "onchain",
        "clear_auth",
        "blind_auth",
        "sqlite",
        "postgres",
        "redis_cache",
        "oidc_provider",
        "wallet_operations"
      ],
      "type": "string"
    },
    "LinkKind": {
      "enum": [
        "bitcoin_peer",
        "lightning_peer",
        "chain_backend",
        "payment_backend",
        "database_backend",
        "authentication_backend",
        "network_path"
      ],
      "type": "string"
    },
    "LockEntry": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "type": "string"
        },
        "build_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalog_id": {
          "type": "string"
        },
        "compatible_dependencies": {
          "items": {
            "$ref": "#/$defs/CatalogDependencySupport"
          },
          "type": "array"
        },
        "component_id": {
          "type": "string"
        },
        "config_schema_digest": {
          "type": "string"
        },
        "config_version": {
          "type": "string"
        },
        "effective_config_digest": {
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/CatalogFeature"
          },
          "type": "array",
          "uniqueItems": true
        },
        "image": {
          "type": "string"
        },
        "protocol_action_adapter_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollout_digest": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_digest": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "catalog_id",
        "adapter_version",
        "version",
        "config_version",
        "config_schema_digest",
        "features",
        "compatible_dependencies",
        "effective_config_digest",
        "rollout_digest",
        "image",
        "source_digest"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string"
    },
    "digest": {
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/LockEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "api_version",
    "digest",
    "entries"
  ],
  "title": "ResolvedLock",
  "type": "object"
}
