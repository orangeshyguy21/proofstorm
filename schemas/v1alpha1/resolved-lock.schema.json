{
  "$defs": {
    "BuildProvenance": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "type": "string"
        },
        "artifact_url": {
          "type": "string"
        },
        "build_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit_sha": {
          "type": "string"
        },
        "dependency_lock_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": "string"
        },
        "recipe_digest": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "runtime_image": {
          "type": "string"
        },
        "transformations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "artifact_url",
        "artifact_sha256",
        "platform",
        "runtime_image",
        "recipe_digest"
      ],
      "type": "object"
    },
    "CandidateBuildProfile": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": "string"
        },
        "catalog_implementations": {
          "description": "Runtime presets served by this artifact. Empty in historical profiles,\nwhich remain restricted to the implementation requested at admission.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "cpu_limit_millicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "deadline_seconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dockerfile": {
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/CatalogFeature"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "type": "string"
        },
        "memory_limit_mib": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "platforms": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "prepare": {
          "description": "Trusted, versioned preparation recipe copied into the immutable build record.",
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "repository",
        "baseline",
        "dockerfile",
        "platforms",
        "features",
        "notes",
        "prepare",
        "cpu_limit_millicores",
        "memory_limit_mib",
        "deadline_seconds"
      ],
      "type": "object"
    },
    "CandidateProvenance": {
      "additionalProperties": false,
      "properties": {
        "baseline_digest": {
          "type": "string"
        },
        "builder_image": {
          "type": "string"
        },
        "input_digest": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/CandidateBuildProfile"
        },
        "profile_digest": {
          "type": "string"
        },
        "requested_source": {
          "additionalProperties": false,
          "properties": {
            "sha": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "type": {
              "enum": [
                "pull_request",
                "commit",
                "tag"
              ],
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_image": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "input_digest",
        "requested_source",
        "platform",
        "source_image",
        "builder_image",
        "baseline_digest",
        "profile",
        "profile_digest"
      ],
      "type": "object"
    },
    "CandidateSource": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "pull_request_url": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "pull_request_url",
        "repository",
        "commit_sha"
      ],
      "type": "object"
    },
    "CatalogDependencySupport": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "type": "string"
        },
        "link_kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "versions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "link_kind",
        "implementation",
        "versions"
      ],
      "type": "object"
    },
    "CatalogFeature": {
      "enum": [
        "native_cli",
        "native_cli_entrypoints",
        "mint_management_rpc",
        "regtest",
        "persistent_state",
        "bolt11",
        "bolt12",
        "onchain",
        "clear_auth",
        "blind_auth",
        "sqlite",
        "postgres",
        "redis_cache",
        "oidc_provider",
        "wallet_operations"
      ],
      "type": "string"
    },
    "LinkKind": {
      "enum": [
        "bitcoin_peer",
        "lightning_peer",
        "chain_backend",
        "payment_backend",
        "database_backend",
        "authentication_backend",
        "network_path"
      ],
      "type": "string"
    },
    "LockEntry": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "type": "string"
        },
        "build_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalog_id": {
          "type": "string"
        },
        "compatible_dependencies": {
          "items": {
            "$ref": "#/$defs/CatalogDependencySupport"
          },
          "type": "array"
        },
        "component_id": {
          "type": "string"
        },
        "config_schema_digest": {
          "type": "string"
        },
        "config_version": {
          "type": "string"
        },
        "effective_config_digest": {
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/CatalogFeature"
          },
          "type": "array",
          "uniqueItems": true
        },
        "image": {
          "type": "string"
        },
        "protocol_action_adapter_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollout_digest": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_digest": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "catalog_id",
        "adapter_version",
        "version",
        "config_version",
        "config_schema_digest",
        "features",
        "compatible_dependencies",
        "effective_config_digest",
        "rollout_digest",
        "image",
        "source_digest"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string"
    },
    "digest": {
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/LockEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "api_version",
    "digest",
    "entries"
  ],
  "title": "ResolvedLock",
  "type": "object"
}
