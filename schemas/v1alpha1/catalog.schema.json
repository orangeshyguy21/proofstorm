{
  "$defs": {
    "AuthenticationMode": {
      "enum": [
        "unauthenticated",
        "nut21_clear",
        "nut22_blind"
      ],
      "type": "string"
    },
    "BuildProvenance": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "type": "string"
        },
        "artifact_url": {
          "type": "string"
        },
        "build_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit_sha": {
          "type": "string"
        },
        "dependency_lock_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": "string"
        },
        "recipe_digest": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "runtime_image": {
          "type": "string"
        },
        "transformations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "artifact_url",
        "artifact_sha256",
        "platform",
        "runtime_image",
        "recipe_digest"
      ],
      "type": "object"
    },
    "CandidateBuildProfile": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": "string"
        },
        "catalog_implementations": {
          "description": "Runtime presets served by this artifact. Empty in historical profiles,\nwhich remain restricted to the implementation requested at admission.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "cpu_limit_millicores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "deadline_seconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dockerfile": {
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/CatalogFeature"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "type": "string"
        },
        "memory_limit_mib": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "platforms": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "prepare": {
          "description": "Trusted, versioned preparation recipe copied into the immutable build record.",
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "repository",
        "baseline",
        "dockerfile",
        "platforms",
        "features",
        "notes",
        "prepare",
        "cpu_limit_millicores",
        "memory_limit_mib",
        "deadline_seconds"
      ],
      "type": "object"
    },
    "CandidateProvenance": {
      "additionalProperties": false,
      "properties": {
        "baseline_digest": {
          "type": "string"
        },
        "builder_image": {
          "type": "string"
        },
        "input_digest": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/CandidateBuildProfile"
        },
        "profile_digest": {
          "type": "string"
        },
        "requested_source": {
          "additionalProperties": false,
          "properties": {
            "sha": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "type": {
              "enum": [
                "pull_request",
                "commit",
                "tag"
              ],
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_image": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "input_digest",
        "requested_source",
        "platform",
        "source_image",
        "builder_image",
        "baseline_digest",
        "profile",
        "profile_digest"
      ],
      "type": "object"
    },
    "CandidateSource": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "pull_request_url": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "pull_request_url",
        "repository",
        "commit_sha"
      ],
      "type": "object"
    },
    "CatalogDependencySupport": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "type": "string"
        },
        "link_kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "versions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "link_kind",
        "implementation",
        "versions"
      ],
      "type": "object"
    },
    "CatalogEmbeddedPaymentBindingSupport": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/PaymentMethod"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "unit",
        "backend"
      ],
      "type": "object"
    },
    "CatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "type": "string"
        },
        "allowed_control": {
          "items": {
            "$ref": "#/$defs/ControlClass"
          },
          "type": "array"
        },
        "build_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "compatible_dependencies": {
          "items": {
            "$ref": "#/$defs/CatalogDependencySupport"
          },
          "type": "array"
        },
        "config_schema": true,
        "config_schema_digest": {
          "type": "string"
        },
        "config_version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/CatalogFeature"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "protocol_action_adapter_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_channel": {
          "$ref": "#/$defs/ReleaseChannel"
        },
        "runtime_endpoints": {
          "description": "Runtime operations implemented by the installed driver, independently\nfrom protocol support advertised by the component itself.",
          "items": {
            "$ref": "#/$defs/CatalogRuntimeEndpoint"
          },
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_digest": {
          "type": "string"
        },
        "support_lifecycle": {
          "$ref": "#/$defs/SupportLifecycle"
        },
        "support_matrix": {
          "$ref": "#/$defs/CatalogSupportMatrix"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "adapter_version",
        "version",
        "release_channel",
        "support_lifecycle",
        "config_version",
        "config_schema",
        "config_schema_digest",
        "features",
        "compatible_dependencies",
        "support_matrix",
        "runtime_endpoints",
        "image",
        "source_digest",
        "allowed_control"
      ],
      "type": "object"
    },
    "CatalogFeature": {
      "enum": [
        "native_cli",
        "native_cli_entrypoints",
        "mint_management_rpc",
        "regtest",
        "persistent_state",
        "bolt11",
        "bolt12",
        "onchain",
        "clear_auth",
        "blind_auth",
        "sqlite",
        "postgres",
        "redis_cache",
        "oidc_provider",
        "wallet_operations"
      ],
      "type": "string"
    },
    "CatalogImplementationSupport": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "type": "string"
        },
        "minimum_supported": {
          "type": [
            "string",
            "null"
          ]
        },
        "preferred_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "supported_versions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "implementation",
        "supported_versions"
      ],
      "type": "object"
    },
    "CatalogPaymentBindingSupport": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/CatalogVersionSupport"
        },
        "method": {
          "$ref": "#/$defs/PaymentMethod"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "unit",
        "backend"
      ],
      "type": "object"
    },
    "CatalogRuntimeEndpoint": {
      "additionalProperties": false,
      "description": "A logical runtime endpoint exposed by one catalog component.\n\nEndpoint and control identifiers intentionally remain open strings. New\nadapters can therefore extend the runtime contract without growing the MCP\ntool schema. `component` names the component's primary endpoint; embedded\nbackends use their catalog binding identifier (for example `ldk-node`).",
      "properties": {
        "controls": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "controls"
      ],
      "type": "object"
    },
    "CatalogSupportMatrix": {
      "additionalProperties": false,
      "properties": {
        "authentication": {
          "items": {
            "$ref": "#/$defs/AuthenticationMode"
          },
          "type": "array",
          "uniqueItems": true
        },
        "compatible_wallet_adapters": {
          "items": {
            "$ref": "#/$defs/CatalogVersionSupport"
          },
          "type": "array"
        },
        "embedded_payment_bindings": {
          "description": "Exact payment tuples implemented inside the component image rather\nthan reached through a topology dependency.",
          "items": {
            "$ref": "#/$defs/CatalogEmbeddedPaymentBindingSupport"
          },
          "type": "array",
          "uniqueItems": true
        },
        "payment_backends": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "payment_bindings": {
          "description": "Exact mint payment tuples; the summary sets above are projections, not\npermission to assume their Cartesian product is supported.",
          "items": {
            "$ref": "#/$defs/CatalogPaymentBindingSupport"
          },
          "type": "array",
          "uniqueItems": true
        },
        "payment_methods": {
          "items": {
            "$ref": "#/$defs/PaymentMethod"
          },
          "type": "array",
          "uniqueItems": true
        },
        "storage": {
          "items": {
            "$ref": "#/$defs/StorageBackend"
          },
          "type": "array",
          "uniqueItems": true
        },
        "units": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "storage",
        "payment_methods",
        "payment_backends",
        "units",
        "payment_bindings",
        "authentication",
        "compatible_wallet_adapters"
      ],
      "type": "object"
    },
    "CatalogVersionSupport": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "type": "string"
        },
        "versions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "implementation",
        "versions"
      ],
      "type": "object"
    },
    "ComponentKind": {
      "enum": [
        "bitcoin",
        "lightning",
        "payment_processor",
        "mint",
        "database",
        "identity_provider",
        "wallet",
        "workspace",
        "proxy",
        "oracle"
      ],
      "type": "string"
    },
    "ControlClass": {
      "enum": [
        "cell",
        "target",
        "workspace",
        "oracle"
      ],
      "type": "string"
    },
    "LinkKind": {
      "enum": [
        "bitcoin_peer",
        "lightning_peer",
        "chain_backend",
        "payment_backend",
        "database_backend",
        "authentication_backend",
        "network_path"
      ],
      "type": "string"
    },
    "PaymentMethod": {
      "enum": [
        "bolt11",
        "bolt12",
        "onchain"
      ],
      "type": "string"
    },
    "ReleaseChannel": {
      "enum": [
        "stable",
        "prerelease"
      ],
      "type": "string"
    },
    "StorageBackend": {
      "enum": [
        "ephemeral",
        "persistent_volume",
        "sqlite",
        "postgres"
      ],
      "type": "string"
    },
    "SupportLifecycle": {
      "enum": [
        "preferred",
        "supported",
        "deprecated",
        "experimental"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/CatalogEntry"
      },
      "type": "array"
    },
    "implementations": {
      "items": {
        "$ref": "#/$defs/CatalogImplementationSupport"
      },
      "type": "array"
    }
  },
  "required": [
    "api_version",
    "implementations",
    "entries"
  ],
  "title": "CatalogResponse",
  "type": "object"
}
