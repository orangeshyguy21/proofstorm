{
  "$defs": {
    "Capability": {
      "enum": [
        "catalog.read",
        "lab.read",
        "lab.create",
        "lab.edit",
        "lab.clone",
        "lab.validate",
        "lab.publish",
        "lab.materialize",
        "lab.status",
        "lab.close",
        "experiment.create",
        "experiment.read",
        "experiment.close",
        "lease.acquire",
        "lease.release",
        "action.cancel",
        "topology.inspect",
        "topology.mutate",
        "node.add",
        "node.remove",
        "node.control",
        "component.control",
        "component.control",
        "peer.connect",
        "peer.disconnect",
        "wallet.create",
        "wallet.control",
        "wallet.fund",
        "channel.open",
        "channel.close",
        "channel.force_close",
        "channel.rebalance",
        "chain.mine",
        "chain.fee",
        "chain.reorg",
        "network.delay",
        "network.drop",
        "network.partition",
        "network.heal",
        "component.exec_live",
        "component.forensics",
        "component.exec_live",
        "component.forensics",
        "authentication.test",
        "traffic.capture",
        "oracle.list",
        "oracle.run",
        "artifact.read",
        "policy.read",
        "policy.edit",
        "snapshot.create",
        "snapshot.restore"
      ],
      "type": "string"
    },
    "CatalogDependencySupport": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "type": "string"
        },
        "link_kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "versions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "link_kind",
        "implementation",
        "versions"
      ],
      "type": "object"
    },
    "CatalogFeature": {
      "enum": [
        "native_cli",
        "regtest",
        "persistent_state",
        "bolt11",
        "bolt12",
        "onchain",
        "clear_auth",
        "blind_auth",
        "sqlite",
        "postgres",
        "redis_cache",
        "oidc_provider",
        "wallet_operations"
      ],
      "type": "string"
    },
    "ComponentKind": {
      "enum": [
        "bitcoin",
        "lightning",
        "mint",
        "database",
        "identity_provider",
        "wallet",
        "attacker",
        "proxy",
        "oracle"
      ],
      "type": "string"
    },
    "ComponentSpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "type": "object"
        },
        "config_version": {
          "description": "Version of the implementation adapter's configuration contract.",
          "type": "string"
        },
        "control": {
          "$ref": "#/$defs/ControlClass"
        },
        "id": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "version": {
          "description": "Version of the service binary, image, or implementation.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "implementation",
        "config_version",
        "control",
        "config"
      ],
      "type": "object"
    },
    "ControlClass": {
      "enum": [
        "laboratory",
        "target",
        "attacker",
        "oracle"
      ],
      "type": "string"
    },
    "DependencyBinding": {
      "additionalProperties": false,
      "description": "Typed dependency qualifier. Chain bindings require network; payment bindings require method and unit; database bindings require a role; authentication bindings require a protocol. Proofstorm validates the discriminator-specific fields before publication.",
      "properties": {
        "method": {
          "enum": [
            "bolt11",
            "bolt12",
            "onchain"
          ],
          "type": "string"
        },
        "network": {
          "enum": [
            "regtest"
          ],
          "type": "string"
        },
        "protocol": {
          "enum": [
            "oidc"
          ],
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "cache",
            "authentication"
          ],
          "type": "string"
        },
        "type": {
          "enum": [
            "chain",
            "payment",
            "database",
            "authentication"
          ],
          "type": "string"
        },
        "unit": {
          "maxLength": 16,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object",
      "x-kubernetes-validations": [
        {
          "message": "chain bindings require only network; payment bindings require only method and unit; database bindings require only role; authentication bindings require only protocol",
          "rule": "self.type == 'chain' ? has(self.network) && !has(self.method) && !has(self.unit) && !has(self.role) && !has(self.protocol) : (self.type == 'payment' ? has(self.method) && has(self.unit) && !has(self.network) && !has(self.role) && !has(self.protocol) : (self.type == 'database' ? has(self.role) && !has(self.network) && !has(self.method) && !has(self.unit) && !has(self.protocol) : has(self.protocol) && !has(self.network) && !has(self.method) && !has(self.unit) && !has(self.role)))"
        }
      ]
    },
    "EvidenceAction": {
      "additionalProperties": false,
      "properties": {
        "accepted_at_unix": {
          "format": "int64",
          "type": "integer"
        },
        "artifact_byte_length": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "artifact_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "completed_at_unix": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "experiment_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OperationKind"
        },
        "lease_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/OperationPhase"
        },
        "principal_id": {
          "type": "string"
        },
        "request": true,
        "request_digest": {
          "type": "string"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "started_at_unix": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "instance_id",
        "experiment_id",
        "lease_id",
        "principal_id",
        "sequence",
        "kind",
        "capability",
        "request_digest",
        "request",
        "phase",
        "accepted_at_unix"
      ],
      "type": "object"
    },
    "EvidenceArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/OperationArtifact"
        },
        "kind": {
          "$ref": "#/$defs/OperationKind"
        },
        "operation_id": {
          "type": "string"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "operation_id",
        "sequence",
        "kind",
        "artifact"
      ],
      "type": "object"
    },
    "EvidenceBundleContent": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "type": "string"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/EvidenceArtifact"
          },
          "type": "array"
        },
        "experiment": {
          "$ref": "#/$defs/Experiment"
        },
        "instance": {
          "$ref": "#/$defs/EvidenceInstance"
        },
        "journal": {
          "items": {
            "$ref": "#/$defs/EvidenceAction"
          },
          "type": "array"
        },
        "revision": {
          "$ref": "#/$defs/PublishedRevision"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "workspace_id",
        "experiment",
        "instance",
        "revision",
        "journal",
        "artifacts"
      ],
      "type": "object"
    },
    "EvidenceInstance": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "lock_digest": {
          "type": "string"
        },
        "revision_digest": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision_digest",
        "lock_digest"
      ],
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "properties": {
        "closed_at_unix": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "created_at_unix": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "owner_principal_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/ExperimentPhase"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "instance_id",
        "owner_principal_id",
        "phase",
        "created_at_unix"
      ],
      "type": "object"
    },
    "ExperimentPhase": {
      "enum": [
        "active",
        "closed"
      ],
      "type": "string"
    },
    "LabLimits": {
      "additionalProperties": false,
      "properties": {
        "max_components": {
          "default": 64,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "max_config_bytes": {
          "default": 65536,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_links": {
          "default": 256,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "LabPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array",
          "uniqueItems": true
        },
        "limits": {
          "$ref": "#/$defs/LabLimits",
          "default": {
            "max_components": 64,
            "max_config_bytes": 65536,
            "max_links": 256
          }
        }
      },
      "type": "object"
    },
    "LabSpec": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentSpec"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/LinkSpec"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/LabPolicy",
          "default": {
            "allow": [],
            "limits": {
              "max_components": 64,
              "max_config_bytes": 65536,
              "max_links": 256
            }
          }
        }
      },
      "required": [
        "api_version",
        "name",
        "components",
        "links"
      ],
      "type": "object"
    },
    "LinkKind": {
      "enum": [
        "bitcoin_peer",
        "lightning_peer",
        "chain_backend",
        "payment_backend",
        "database_backend",
        "authentication_backend",
        "network_path"
      ],
      "type": "string"
    },
    "LinkSpec": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/DependencyBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "type": "string"
        },
        "id": {
          "description": "Stable binding identity within one lab revision.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "from",
        "to"
      ],
      "type": "object",
      "x-kubernetes-validations": [
        {
          "message": "backend links require a binding; peer and network-path links forbid one",
          "rule": "(self.kind == 'chain_backend' || self.kind == 'payment_backend' || self.kind == 'database_backend' || self.kind == 'authentication_backend') ? has(self.binding) : !has(self.binding)"
        }
      ]
    },
    "LockEntry": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string"
        },
        "compatible_dependencies": {
          "items": {
            "$ref": "#/$defs/CatalogDependencySupport"
          },
          "type": "array"
        },
        "component_id": {
          "type": "string"
        },
        "config_schema_digest": {
          "type": "string"
        },
        "config_version": {
          "type": "string"
        },
        "effective_config_digest": {
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/CatalogFeature"
          },
          "type": "array",
          "uniqueItems": true
        },
        "image": {
          "type": "string"
        },
        "protocol_action_adapter_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollout_digest": {
          "type": "string"
        },
        "source_digest": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "catalog_id",
        "adapter_version",
        "version",
        "config_version",
        "config_schema_digest",
        "features",
        "compatible_dependencies",
        "effective_config_digest",
        "rollout_digest",
        "image",
        "source_digest"
      ],
      "type": "object"
    },
    "OperationArtifact": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "content": true,
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "digest",
        "byte_length",
        "content"
      ],
      "type": "object"
    },
    "OperationKind": {
      "enum": [
        "node_start",
        "component_restart",
        "node_stop",
        "node_restart",
        "component_restart",
        "bootstrap_liquidity",
        "peer_connect",
        "peer_disconnect",
        "channel_open",
        "channel_policy_set",
        "channel_close",
        "channel_force_close",
        "channel_rebalance",
        "network_partition",
        "network_delay",
        "network_loss",
        "network_heal",
        "wallet_initialize",
        "wallet_balance",
        "wallet_fund",
        "wallet_melt_quote_refresh",
        "wallet_invoice",
        "wallet_pay",
        "wallet_quote_claim",
        "component_forensics",
        "component_exec_live",
        "conservation_oracle",
        "reachability_oracle",
        "component_forensics",
        "component_exec_live",
        "component_logs",
        "authentication_conformance",
        "authentication_protected_spend",
        "authentication_replay"
      ],
      "type": "string"
    },
    "OperationPhase": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "PublishedRevision": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "lab": {
          "$ref": "#/$defs/LabSpec"
        },
        "lock": {
          "$ref": "#/$defs/ResolvedLock"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "digest",
        "lab",
        "lock"
      ],
      "type": "object"
    },
    "ResolvedLock": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/LockEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "api_version",
        "digest",
        "entries"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byte_length": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "content": {
      "$ref": "#/$defs/EvidenceBundleContent"
    },
    "digest": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    }
  },
  "required": [
    "media_type",
    "digest",
    "byte_length",
    "content"
  ],
  "title": "EvidenceBundle",
  "type": "object"
}
